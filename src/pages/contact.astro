---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | pregnancydiscriminationcalc.com';
const description = 'Contact the editorial team at pregnancydiscriminationcalc.com with corrections, feedback, or questions.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about our content, email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>

  <h2>What We Can Help With</h2>
  <ul>
    <li><strong>Corrections:</strong> If you find a factual error — a wrong statute number, an outdated cap amount, a misstated legal standard — let us know with a brief description of the error and, if possible, a citation to the correct authority. We review all correction requests and update content promptly.</li>
    <li><strong>Feedback:</strong> Suggestions for additional guides, calculator features, or topics we haven't covered are welcome.</li>
    <li><strong>Media inquiries:</strong> Reporters, researchers, or educators who want to reference our calculator methodology or guides are welcome to reach out.</li>
  </ul>

  <h2>What We Can't Help With</h2>
  <p>We read every message but are not able to provide legal advice or respond to requests for case-specific analysis. We are an editorial and educational resource, not a law firm. If you need guidance about a potential pregnancy discrimination claim, please consult a licensed employment attorney. Many employment attorneys who handle Title VII and PWFA cases offer free initial consultations and work on contingency (no upfront fee).</p>

  <p>Our typical response time for correction requests and editorial feedback is 2–5 business days.</p>
</BaseLayout>
