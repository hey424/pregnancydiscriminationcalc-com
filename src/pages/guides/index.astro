---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Guides | pregnancydiscriminationcalc.com';
const description = 'In-depth guides covering key topics at pregnancydiscriminationcalc.com.';
---
<BaseLayout title={title} description={description}>
  <h1>Guides</h1>
  <p>Plain-language guides written and reviewed by our editorial team.</p>
  <h3><a href="/guides/how-pregnancy-discrimination-damages-work">How Pregnancy Discrimination Damages Work</a></h3>
  <p>Back pay, compensatory, punitive damages, and Title VII caps for PDA and PWFA violations.</p>
  <h3><a href="/guides/types-of-pregnancy-discrimination">Types of Pregnancy Discrimination</a></h3>
  <p>Termination, failure to accommodate, demotion, hostile environment, and FMLA retaliation claims.</p>
  <h3><a href="/guides/what-to-do-after-pregnancy-discrimination">What to Do After Pregnancy Discrimination</a></h3>
  <p>Documentation, EEOC charge filing, PWFA accommodation requests, and finding employment counsel.</p>
  <h3><a href="/guides/pregnancy-discrimination-misconceptions">Common Pregnancy Discrimination Misconceptions</a></h3>
  <p>Common misunderstandings about PDA coverage, PWFA, FMLA interaction, and what constitutes discrimination.</p>
  <ul style="margin-top:2rem">
    <li><a href="/case-types">Case types overview</a></li>
    <li><a href="/methodology">Calculator methodology</a></li>
  </ul>
</BaseLayout>
